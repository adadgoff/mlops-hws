{
  "dashboard": {
    "title": "ML Backend Service Dashboard",
    "tags": ["ml", "backend"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "RPS по эндпоинтам",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"ml-backend\"}[5m])",
            "legendFormat": "{{method}} {{path}}"
          }
        ]
      },
      {
        "id": 2,
        "title": "Лэтенси p50/p95/p99",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"ml-backend\"}[5m]))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"ml-backend\"}[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"ml-backend\"}[5m]))",
            "legendFormat": "p99"
          }
        ]
      },
      {
        "id": 3,
        "title": "Error Rate (4xx/5xx)",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"ml-backend\",status=~\"4..\"}[5m])) / sum(rate(http_requests_total{job=\"ml-backend\"}[5m])) * 100",
            "legendFormat": "4xx %"
          },
          {
            "expr": "sum(rate(http_requests_total{job=\"ml-backend\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"ml-backend\"}[5m])) * 100",
            "legendFormat": "5xx %"
          }
        ]
      },
      {
        "id": 4,
        "title": "Время инференса модели p50/p99",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(ml_inference_duration_seconds_bucket[5m]))",
            "legendFormat": "Inference p50"
          },
          {
            "expr": "histogram_quantile(0.99, rate(ml_inference_duration_seconds_bucket[5m]))",
            "legendFormat": "Inference p99"
          }
        ]
      }
    ]
  }
}